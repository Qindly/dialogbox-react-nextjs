//npx prisma studio

model Chat {
  id         String    @id @default(uuid())
  title      String
  updateTime DateTime  @updatedAt
  Message    Message[]
}

model Message {
  id         String   @id @default(uuid())
  text       String
  role       String
  updateTime DateTime @default(now())
  chatId     String
  chat       Chat     @relation(fields: [chatId], references: [id])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dialogbox.sqlite"
}
